// ═══════════════════════════════════════════════════════════
// Digital Incubator - Prisma Schema
// ═══════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, uuid_ossp(map: "uuid-ossp")]
}

// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

enum UserRole {
  STUDENT
  MENTOR
  ADMIN
  ORGANIZER
}

enum ProjectStatus {
  IDEA
  VALIDATING
  BUILDING
  LAUNCHED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  CO_FOUNDER
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CourseSource {
  COURSERA
  UDEMY
  EDX
  YOUTUBE
  INTERNAL
  CUSTOM
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EvaluationType {
  QUIZ
  MVP_SUBMISSION
  PEER_REVIEW
  AI_FEEDBACK
}

// ═══════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  avatarUrl     String?
  bio           String?   @db.Text
  role          UserRole  @default(STUDENT)

  // Academic info (optional)
  university    String?
  major         String?
  graduationYear Int?

  // OAuth
  accounts      Account[]
  sessions      Session[]

  // Relations
  ownedProjects       Project[]          @relation("ProjectOwner")
  projectMemberships  ProjectMember[]
  tasksAssigned       Task[]             @relation("TaskAssignee")
  tasksCreated        Task[]             @relation("TaskCreator")
  chatMessages        ChatMessage[]
  submissions         Submission[]
  notifications       Notification[]
  mentorProfile       MentorProfile?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════
// PROJECT / STARTUP
// ═══════════════════════════════════════════════════════════

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String?
  description String        @db.Text
  problem     String?       @db.Text
  solution    String?       @db.Text
  targetMarket String?      @db.Text

  industry    String?
  stage       ProjectStatus @default(IDEA)

  // Visuals
  logoUrl     String?
  coverUrl    String?

  // Ownership
  ownerId     String
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]

  // Features
  roadmap       Roadmap?
  workspace     Workspace?
  chatSessions  ChatSession[]
  submissions   Submission[]

  // Metadata
  isPublic    Boolean       @default(false)
  tags        String[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([ownerId])
  @@index([stage])
  @@index([slug])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ═══════════════════════════════════════════════════════════
// ROADMAP (Feature 1: Startup Roadmap Engine)
// ═══════════════════════════════════════════════════════════

model Roadmap {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  generatedBy String   // "AI" | "MANUAL"
  aiPrompt    String?  @db.Text

  modules     RoadmapModule[]
  progress    Float    @default(0) // 0.0 - 1.0

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roadmaps")
}

model RoadmapModule {
  id          String   @id @default(cuid())
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  description String?  @db.Text
  duration    Int?     // estimated minutes

  // Link to course content
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  lessons     RoadmapLesson[]

  isCompleted Boolean  @default(false)
  completedAt DateTime?

  @@index([roadmapId, order])
  @@map("roadmap_modules")
}

model RoadmapLesson {
  id          String        @id @default(cuid())
  moduleId    String
  module      RoadmapModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  content     String?       @db.Text
  videoUrl    String?

  lessonId    String?
  courseLesson CourseLesson? @relation(fields: [lessonId], references: [id])

  isCompleted Boolean       @default(false)

  @@index([moduleId, order])
  @@map("roadmap_lessons")
}

// ═══════════════════════════════════════════════════════════
// COURSE DATABASE (crawled from Coursera/Udemy/...)
// ═══════════════════════════════════════════════════════════

model Course {
  id            String       @id @default(cuid())
  externalId    String?      // ID từ source
  source        CourseSource
  sourceUrl     String
  title         String
  subtitle      String?
  description   String       @db.Text
  instructor    String?
  language      String       @default("en")

  // Metadata
  duration      Int?         // total minutes
  level         String?      // beginner, intermediate, advanced
  rating        Float?
  enrolledCount Int?
  price         Float?
  thumbnailUrl  String?

  // Content
  modules       CourseModule[]
  roadmapModules RoadmapModule[]

  // Categorization
  category      String?
  tags          String[]
  topics        String[]

  // AI embedding cho semantic search
  embedding     Unsupported("vector(1536)")?

  // Meta
  crawledAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([source, externalId])
  @@index([category])
  @@index([source])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  description String?  @db.Text
  duration    Int?

  lessons     CourseLesson[]

  @@index([courseId, order])
  @@map("course_modules")
}

model CourseLesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  content     String?      @db.Text
  videoUrl    String?
  duration    Int?

  roadmapLessons RoadmapLesson[]

  @@index([moduleId, order])
  @@map("course_lessons")
}

// ═══════════════════════════════════════════════════════════
// WORKSPACE (Feature 3: Startup Workspace)
// ═══════════════════════════════════════════════════════════

model Workspace {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks     Task[]
  documents Document[]
  checklists Checklist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model Checklist {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title       String
  description String?   @db.Text
  items       ChecklistItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  order       Int
  content     String
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  @@index([checklistId, order])
  @@map("checklist_items")
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])

  dueDate     DateTime?
  completedAt DateTime?

  tags        String[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Document {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  type        String    // pdf, docx, image, etc.
  url         String
  size        Int       // bytes
  mimeType    String

  uploadedBy  String
  description String?   @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("documents")
}

// ═══════════════════════════════════════════════════════════
// AI MENTOR (Feature 2: AI Co-Founder)
// ═══════════════════════════════════════════════════════════

model ChatSession {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title     String?
  messages  ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_sessions")
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?       @relation(fields: [userId], references: [id])

  role          ChatRole
  content       String      @db.Text

  // RAG metadata
  sources       Json?       // [{docId, snippet, score}]
  tokensUsed    Int?
  model         String?

  createdAt     DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// Knowledge base for RAG
model KnowledgeDocument {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  source      String   // "legal", "startup-guide", "case-study"
  category    String?
  tags        String[]

  // Chunks stored in Qdrant, but metadata here
  chunkCount  Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source])
  @@map("knowledge_documents")
}

// ═══════════════════════════════════════════════════════════
// SUBMISSIONS & EVALUATIONS
// ═══════════════════════════════════════════════════════════

model Submission {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId      String
  user        User           @relation(fields: [userId], references: [id])

  type        EvaluationType
  title       String
  description String?        @db.Text
  fileUrl     String?
  content     String?        @db.Text

  // AI Evaluation
  aiScore     Float?
  aiFeedback  String?        @db.Text
  aiEvaluatedAt DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId])
  @@map("submissions")
}

// ═══════════════════════════════════════════════════════════
// MENTOR (Future feature)
// ═══════════════════════════════════════════════════════════

model MentorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expertise    String[]
  bio          String   @db.Text
  yearsOfExp   Int
  linkedinUrl  String?
  hourlyRate   Float?

  isAvailable  Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("mentor_profiles")
}

// ═══════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // task_assigned, ai_feedback, mentor_reply...
  title     String
  message   String   @db.Text
  link      String?
  metadata  Json?

  isRead    Boolean  @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
