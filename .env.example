# ═══════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════
NODE_ENV=development
APP_NAME="Digital Incubator"
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════
# DATABASE - PostgreSQL
# ═══════════════════════════════════════════════════════════
DATABASE_URL="postgresql://incubator:incubator_dev_password@localhost:5432/incubator?schema=public"
DATABASE_POOL_SIZE=10

# ═══════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════
# VECTOR DATABASE - Qdrant
# ═══════════════════════════════════════════════════════════
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=incubator_knowledge

# ═══════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════
# AI / LLM
# ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Local LLM via Ollama
OLLAMA_BASE_URL=http://localhost:11434

# AI Config
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_RATE_LIMIT_PER_USER=50

# ═══════════════════════════════════════════════════════════
# STORAGE - S3 / MinIO
# ═══════════════════════════════════════════════════════════
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=incubator-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000

# ═══════════════════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════════════════
RESEND_API_KEY=
EMAIL_FROM="Digital Incubator <noreply@incubator.vn>"
EMAIL_REPLY_TO=support@incubator.vn

# ═══════════════════════════════════════════════════════════
# MONITORING & OBSERVABILITY
# ═══════════════════════════════════════════════════════════
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════
FEATURE_AI_MENTOR=true
FEATURE_MENTOR_BOOKING=false
FEATURE_CASE_STUDY=false

# ═══════════════════════════════════════════════════════════
# CRAWLER
# ═══════════════════════════════════════════════════════════
CRAWLER_USER_AGENT="DigitalIncubatorBot/1.0"
CRAWLER_DELAY_MS=1000
CRAWLER_CONCURRENT_REQUESTS=4
